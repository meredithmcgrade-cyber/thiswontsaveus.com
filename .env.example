# Sanity (leave blank to run from the local seed JSON in src/content/seed)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Server-only. Needed for `npm run seed:import` (Editor token) and the publish webhook.
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Public URL, used for canonical links, sitemap and share links
NEXT_PUBLIC_SITE_URL=https://thiswontsaveus.com
